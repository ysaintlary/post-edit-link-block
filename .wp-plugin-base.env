FOUNDATION_RELEASE_SOURCE_PROVIDER=github-release
FOUNDATION_RELEASE_SOURCE_REFERENCE=MatthiasReinholz/wp-plugin-base
FOUNDATION_VERSION=v1.10.0

PLUGIN_NAME="Post Edit Link"
PLUGIN_SLUG=post-edit-link-block
MAIN_PLUGIN_FILE=post-edit-link-block.php
README_FILE=readme.txt
ZIP_FILE=post-edit-link-block.zip

PHP_VERSION=8.0
NODE_VERSION=22

AUTOMATION_PROVIDER=github

PLUGIN_RUNTIME_UPDATE_PROVIDER=github-release
PLUGIN_RUNTIME_UPDATE_SOURCE_URL=https://github.com/ysaintlary/post-edit-link-block

WORDPRESS_READINESS_ENABLED=true
WORDPRESS_QUALITY_PACK_ENABLED=true
WORDPRESS_SECURITY_PACK_ENABLED=true
WP_PLUGIN_BASE_PLUGIN_CHECK_EXCLUDE_CHECKS=plugin_updater
WP_PLUGIN_BASE_PLUGIN_CHECK_IGNORE_CODES=WordPress.WP.I18n.NonSingularStringLiteralText,WordPress.WP.I18n.NonSingularStringLiteralDomain,WordPress.WP.I18n.MissingArgDomain,WordPress.WP.I18n.MissingTranslatorsComment,WordPress.WP.I18n.TextDomainMismatch,missing_direct_file_access_protection,plugin_updater_detected,WordPress.Security.EscapeOutput.ExceptionNotEscaped,readme_short_description_non_official_language,readme_description_non_official_language
